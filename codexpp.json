{
  "id": "usage-statusline",
  "name": "用量状态栏",
  "version": "1.2.0",
  "description": "在输入框下方显示解码速度、缓存命中率、Token 用量和上下文占用，提供 DSH 风格的紧凑明细浮层。数据来自本机 Codex 会话与请求记录，不改变请求内容。",
  "engines": {
    "codexpp": 1
  },
  "renderer": [
    "statusline.js",
    "main.js"
  ],
  "permissions": {
    "routes": [
      "/thread-usage-live",
      "/thread-usage-history",
      "/request-log/recent",
      "/diagnostics/log"
    ]
  },
  "repository": "YOUIMARK/codexpp-usage-statusline"
}